# Port HTTP server
PORT=3000
# Lokasi database SQLite (libsql). Default: file:./data/absen-kilat.db
DATABASE_URL=file:./data/absen-kilat.db
# Folder penyimpanan foto absen
UPLOAD_DIR=./uploads
# URL publik server (dipakai Better Auth untuk tautan verifikasi & reset)
BETTER_AUTH_URL=http://localhost:3000
# Secret acak minimal 32 karakter — WAJIB diganti di produksi (mis. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# Asal yang dipercaya (dipisah koma): skema aplikasi & dev server Expo web
TRUSTED_ORIGINS=absenkilat://,exp://,http://localhost:8081
